# Woozies proxy settings. Copy to .env and adjust; real environment variables win over .env.

# --- Client and apps -----------------------------------------------------------
# Identifies your apps to the proxy (sent as X-Client-Id). Not a secret.
CLIENT_ID=woozies-ios
# Apps this proxy serves, comma-separated. The single-value IOS_BUNDLE_ID and
# ANDROID_PACKAGE are still read if these are unset.
IOS_BUNDLE_IDS=com.woosmap.app.woozies
ANDROID_PACKAGES=com.woosmap.app.woozies

# --- Attestation ---------------------------------------------------------------
# enforce: reject unverified calls | monitor: forward but log | off: skip the check
ATTEST_MODE=enforce
# Accept App Attest keys from development builds. Set false for App Store/TestFlight.
IOS_ALLOW_DEVELOPMENT=true
# Apple's App Attestation Root CA. Defaults to certs/Apple_App_Attestation_Root_CA.pem if present.
# APPLE_ROOT_CA_PATH=certs/Apple_App_Attestation_Root_CA.pem
# Simulator/emulator debug tokens, comma-separated. Leave empty outside a developer machine.
ATTEST_DEBUG_TOKENS=woozies-simulator-debug

# --- App tokens ----------------------------------------------------------------
# EC P-256 key that signs app tokens. Without it, a new key is made on every start.
# Create one: openssl ecparam -name prime256v1 -genkey -noout -out signing-key.pem
# ATTEST_SIGNING_KEY=signing-key.pem
# ATTEST_SIGNING_KID=woozies-1
# App token lifetime in seconds (300-3600).
TOKEN_TTL_SECONDS=1800

# --- Android: Play Integrity ---------------------------------------------------
# Service-account JSON with Play Integrity API access. Empty disables Play Integrity.
# PLAY_INTEGRITY_CREDENTIALS=certs/play-integrity-service-account.json
# SHA-256 of your app signing certificate(s), comma-separated. Empty skips the check.
# ANDROID_CERT_SHA256=

# --- Firebase App Check (optional) ---------------------------------------------
# FIREBASE_PROJECT_NUMBER=
# FIREBASE_APP_IDS=

# --- Woosmap -------------------------------------------------------------------
# WOOSMAP_API_BASE=https://api.woosmap.com
# API paths the proxy forwards, comma-separated. Replaces the default list.
# ALLOWED_APIS=localities/autocomplete,localities/details,localities/geocode,localities/nearby