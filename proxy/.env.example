# Woosmap private key used ONLY by this proxy. Restrict it to the proxy's IP in the Woosmap Console.
WOOSMAP_PRIVATE_KEY=your-woosmap-private-key

# Must match AppConfig.clientId in the iOS app
CLIENT_ID=woozies-ios

# App Attest: the App ID is APPLE_TEAM_ID + "." + IOS_BUNDLE_ID
IOS_BUNDLE_ID=com.woosmap.app.woozies
APPLE_TEAM_ID=
# Accept builds signed for the App Attest development environment (Xcode debug builds)
IOS_ALLOW_DEVELOPMENT=true
# Defaults to certs/Apple_App_Attestation_Root_CA.pem if that file exists
# APPLE_ROOT_CA_PATH=

# off | monitor | enforce
ATTEST_MODE=enforce
TOKEN_TTL_SECONDS=1800

# Simulator / CI only: comma-separated tokens accepted by /attest/debug/token.
# Must match AppConfig.debugAttestationToken in the iOS app. Leave empty in production.
ATTEST_DEBUG_TOKENS=

# Optional: stable token signing key (EC P-256 PEM). Without it a new key is generated at startup.
# ATTEST_SIGNING_KEY=signing-key.pem

# Optional Firebase App Check support (the Woozies app doesn't use it)
FIREBASE_PROJECT_NUMBER=
FIREBASE_APP_IDS=
