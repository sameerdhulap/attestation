# Copy to secrets.properties (git-ignored) and fill in.
# Woosmap key restricted to Android: package com.woosmap.app.woozies plus your signing SHA-1.
WOOSMAP_API_KEY=your-woosmap-key
# Google Cloud project number linked to Play Integrity (Play Console > App integrity). 0 = emulator debug token only.
PLAY_INTEGRITY_PROJECT_NUMBER=0
# Proxy address. Emulator: http://10.0.2.2:8000. Device: http://<your-mac-ip>:8000 (add the IP to network_security_config.xml)
PROXY_BASE_URL=http://10.0.2.2:8000
